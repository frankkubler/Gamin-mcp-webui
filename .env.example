# Copiez en .env et adaptez. Aucune de ces valeurs n'est un secret Garmin :
# l'interface ne parle jamais a Garmin, elle lit seulement la base de garmin-mcp.

# Chemin de la base SQLite de garmin-mcp (cle database-path de sa configuration).
WEBUI_DATABASE_PATH=/data/garmin.db

# Acces a l'interface (HTTP Basic dans le navigateur).
WEBUI_USERNAME=admin
WEBUI_PASSWORD=

# Jeton porteur optionnel, pour les appels programmatiques a l'API JSON.
WEBUI_API_TOKEN=

# Ouvrir l'interface sans authentification (uniquement derriere un proxy qui
# authentifie deja). 1 pour activer.
WEBUI_ALLOW_ANONYMOUS=0

# Masquer les adresses e-mail dans l'interface et les exports (1 pour activer).
WEBUI_MASK_EMAILS=0

# Seuils de classement des comptes, en jours.
WEBUI_ACTIVE_DAYS=7
WEBUI_IDLE_DAYS=30

# Duree de validite de la copie de la base quand la lecture directe echoue.
WEBUI_SNAPSHOT_TTL_SECONDS=5

# Ecoute HTTP.
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_TITLE=Comptes garmin-mcp
