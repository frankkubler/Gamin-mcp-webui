# Copiez en .env et adaptez, puis : docker compose up -d --build

# ---------------------------------------------------------------------------
# Serveur MCP (garmin-mcp). Chaque cle de sa configuration a une variable
# d'environnement : la cle en majuscules, tirets remplaces par des soulignes,
# prefixee GARMIN_MCP_. Voir garmin-mcp/docs/configuration.md.
# ---------------------------------------------------------------------------

# URL publique de l'endpoint MCP, telle que les clients la voient. Elle doit
# etre en https, sauf boucle locale ou GARMIN_MCP_ALLOW_INSECURE_HTTP=true.
GARMIN_MCP_PUBLIC_URL=https://mcp.exemple.fr/mcp

# Registre des clients OAuth, en JSON (il n'y a pas d'enregistrement dynamique :
# un client existe parce que vous l'avez ecrit ici). L'URI de redirection doit
# correspondre octet pour octet a celle du client.
# La portee garmin:write autorise le palier d'ecriture entier ; retirez-la pour
# un deploiement strictement en lecture. Attention : le serveur annonce les
# portees que vous ecrivez ici, quelles qu'elles soient, mais seules
# garmin:write et garmin:destructive commandent les paliers. Une portee au nom
# approchant est acceptee partout et n'autorise rien.
GARMIN_MCP_OAUTH_CLIENTS=[{"id":"claude-desktop","name":"Claude Desktop","redirect-uris":["http://127.0.0.1:33418/callback"],"scopes":["garmin:read","garmin:write"],"resources":["https://mcp.exemple.fr/mcp"],"public":true}]

# Ecoute dans le conteneur. Une ecoute hors boucle locale exige du TLS, des
# reseaux de proxy de confiance, ou l'override de developpement ci-dessous.
GARMIN_MCP_BIND_ADDRESS=0.0.0.0:8180

# Override de developpement : autorise une URL publique et une ecoute en clair
# hors boucle locale. A n'utiliser que derriere un reverse proxy TLS.
GARMIN_MCP_ALLOW_INSECURE_HTTP=true

# Reseaux dont les en-tetes X-Forwarded-* sont acceptes (vide = aucun).
GARMIN_MCP_TRUSTED_PROXY_CIDRS=

# garmin.com ou garmin.cn.
GARMIN_MCP_REGION=garmin.com

# Outils d'ecriture. true sert les 37 outils du palier ; ce qui decide vraiment
# est la portee accordee par la personne : sans garmin:write dans le client
# OAuth ci-dessus et dans son consentement, aucune ecriture n'est possible.
# Pour n'ouvrir que les seances, ajoutez GARMIN_MCP_TOOL_DENYLIST. Voir la
# section « Ecrire les seances dans Garmin » du README.
GARMIN_MCP_ENABLE_WRITE_TOOLS=true

# Outils de suppression (supprimer ou deplanifier une seance). Exige en plus une
# portee garmin:destructive, non accordee dans l'exemple ci-dessus.
GARMIN_MCP_ENABLE_DESTRUCTIVE_TOOLS=false

# Ajout de ce depot : un nouveau compte attend d'etre valide dans l'interface avant
# de pouvoir servir. Mettre false rend le comportement amont, ou un compte est
# utilisable des que son login Garmin a reussi.
GARMIN_MCP_REQUIRE_ACCOUNT_APPROVAL=true

GARMIN_MCP_LOG_LEVEL=info
GARMIN_MCP_LOG_FORMAT=json

# --- Notification par e-mail d'un compte en attente de validation ----------
# Vide n'envoie rien. Le secret n'est PAS une variable d'environnement : le
# serveur ne rend aucun identifiant configurable, seul le chemin d'un fichier
# l'est. Avec Gmail, utilisez un mot de passe d'application.
GARMIN_MCP_SMTP_HOST=
GARMIN_MCP_SMTP_PORT=587
GARMIN_MCP_SMTP_USER=
GARMIN_MCP_SMTP_SECRET_FILE=/run/secrets/smtp
GARMIN_MCP_SMTP_FROM=
GARMIN_MCP_SMTP_TO=
GARMIN_MCP_SMTP_TLS=starttls

# Lien vers l'interface, place dans le message de notification.
GARMIN_MCP_DASHBOARD_URL=

# ---------------------------------------------------------------------------
# Interface web des comptes.
# ---------------------------------------------------------------------------

# Acces a l'interface (HTTP Basic dans le navigateur). Obligatoire.
WEBUI_USERNAME=admin
WEBUI_PASSWORD=

# Jeton porteur optionnel, pour les appels programmatiques a l'API JSON.
WEBUI_API_TOKEN=

# Masquer les adresses e-mail dans l'interface et les exports (1 pour activer).
WEBUI_MASK_EMAILS=0

# Seuils de classement des comptes, en jours.
WEBUI_ACTIVE_DAYS=7
WEBUI_IDLE_DAYS=30

WEBUI_TITLE=Comptes garmin-mcp

# ---------------------------------------------------------------------------
# Conteneur.
# ---------------------------------------------------------------------------

# les-deux (defaut), mcp, ou webui : quels services le conteneur lance.
RUN_SERVICES=les-deux

# Identite de build inscrite dans `garmin-mcp version`.
GARMIN_MCP_VERSION=fork-webui
GARMIN_MCP_COMMIT=inconnu

# Interface web hors conteneur : chemin de la base SQLite de garmin-mcp.
# WEBUI_DATABASE_PATH=/data/garmin.db
